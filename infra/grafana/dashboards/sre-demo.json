      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{service=\"$service\",status=~\"5..\"}[1m])) / clamp_min(sum(rate(http_requests_total{service=\"$service\"}[1m])), 0.001)",
          "legendFormat": "5xx / усі",
          "refId": "A"
