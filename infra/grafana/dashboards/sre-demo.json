    {
      "type": "logs",
      "title": "Помилки в логах",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"$service\"} | json | level=\"error\"",
          "refId": "A"
        }
      ],
      "options": {
