# Модель: ключ Anthropic (sk-ant-...) або OpenRouter (sk-or-...) — провайдер визначається за префіксом
ANTHROPIC_API_KEY=

# Slack. Без токена агент пише у файл-емуляцію (data/slack_threads.json)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=#sre-agent

# Інфраструктура стенду
QDRANT_URL=http://localhost:6333
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000
ALERTMANAGER_URL=http://localhost:9093

# Langfuse (ключі створює compose через LANGFUSE_INIT_*)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-demo
LANGFUSE_SECRET_KEY=sk-lf-demo
